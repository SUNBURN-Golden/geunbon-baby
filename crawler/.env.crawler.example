# Linux 크롤러·로컬 수집기 예시입니다. 사이트 .dev.vars에 넣지 마세요.
# 사용: cp crawler/.env.crawler.example .env.crawler  (루트, gitignore 대상)
# Instagram worker는 시작 시 루트 .env.crawler를 읽고, 이미 주입된 환경변수를 우선합니다.
AGAMAJUNG_API_URL=http://localhost:8787
# 사이트 INGEST_TOKEN과 같은 값.
INGEST_TOKEN=
AGAMAJUNG_IG_USER=agamajung
AGAMAJUNG_IG_PASSWORD=
AGAMAJUNG_HEADLESS=0
AGAMAJUNG_ONCE=1
AGAMAJUNG_OCR=1
AGAMAJUNG_OCR_LANG=kor+eng
# Daily quiet windows in Asia/Seoul; supports crossing midnight (e.g. 23:00-02:00).
# AGAMAJUNG_QUIET_WINDOW remains supported; the plural variable takes precedence.
AGAMAJUNG_QUIET_WINDOWS=06:45-08:00,13:00-14:00
# 구형 AGAMAJUNG_EXTERNAL_DRY_RUN=1은 주입 환경변수·.env.crawler 모두 이관 안내 후 Instagram 실행 없이 종료하며, 0·1·빈 값 외에는 시작 전 종료코드 1로 거부합니다.

# 독립 로컬 수집함(collector:worker)은 이 파일을 자동으로 읽지 않으므로 비밀 저장소 등으로 주입합니다.
COLLECTOR_INTAKE_TOKEN=
COLLECTOR_REVIEW_TOKEN=
COLLECTOR_EXTENSION_ORIGIN=
# 기본 비어 있음. 샌드박스·프록시 가상 대역(예: 198.18.0.0/15)을 운영자가 명시할 때만 허용.
# 루프백·링크로컬·멀티캐스트와 겹치는 대역은 지정해도 거부. 쉼표로 여러 개 가능.
COLLECTOR_TRUSTED_EGRESS_CIDRS=
COLLECTOR_DB=crawler/.cache/collector.sqlite
COLLECTOR_CONFIG=crawler/config/collector.json
COLLECTOR_SITE_URL=
# sync에는 사이트에 바인딩한 것과 같은 COLLECTOR_STATUS_TOKEN도 필요합니다.
# 사이트 바인딩 값이므로 이 예시에는 두지 않고 비밀 저장소에서 주입합니다(24자 이상·앞뒤 공백 없이·다른 토큰과 다르게).

# 공용 엔진: 두 경로 모두 저장소 밖이어야 합니다 (디렉터리 0700, 파일 0600).
# 기존 serve/discover/sync 기본 경로는 그대로 유지됩니다.
# COLLECTOR_DB=/workspace/agamajung/data/collector/collector.sqlite
# COLLECTOR_RAW_DIR=/workspace/agamajung/data/collector/raw

# Linux 소스 발견기: 기본 설정은 disabled. 후보는 수집/공식 출처 승인이 아닙니다.
# COLLECTOR_DISCOVERY_CONFIG=/workspace/agamajung/data/collector/source-discovery.json
# 제공자 config.auth_env에는 환경변수 이름만 지정합니다. 값은 비밀 저장소에서 주입합니다.
# COLLECTOR_SEARCH_API_KEY=
