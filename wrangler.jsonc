{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agamajung",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "agamajung" }],
  "d1_databases": [{ "binding": "DB", "database_name": "agamajung", "database_id": "4f48b5da-d7d9-4a92-bcb4-891c3c23fd6b", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "agamajung-images" }],
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": true }
}
