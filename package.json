{
  "type": "module",
  "name": "agamajung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev-daemon": "tsx tools/dev-daemon/index.ts",
    "dev": "npm run build:worker && wrangler dev --local",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "tsx scripts/seed.ts && wrangler d1 execute DB --local --file=.local/seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "next": "^16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.4.2",
    "miniflare": "5.20261006.1-alpha",
    "node": "22.20.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.149.0"
  }
}
