ADMIN_TOKEN=
INGEST_TOKEN=
# 소셜 로그인(구글·카카오). 비어 있는 공급자는 버튼이 숨겨지고 login/callback이 404입니다.
# 구글은 ID·SECRET 둘 다, 카카오는 REST_KEY가 있어야 켜집니다(KAKAO_CLIENT_SECRET은 선택).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
# 리디렉트 URI의 기준 주소. 비우면 https://agamajoong.soulbound.co.kr 입니다. 로컬은 아래 값을 쓰세요.
# AUTH_ORIGIN=http://localhost:8787
AUTH_ORIGIN=
NEXTJS_ENV=development
AGAMAJUNG_API_URL=http://localhost:8787
AGAMAJUNG_IG_USER=agamajung
AGAMAJUNG_IG_PASSWORD=
AGAMAJUNG_HEADLESS=0
AGAMAJUNG_ONCE=1
AGAMAJUNG_OCR=1
AGAMAJUNG_OCR_LANG=kor+eng

# 신규 수집기는 별도 Linux 프로세스. 아래 값은 해당 프로세스에만 주입합니다.
# 사이트에는 COLLECTOR_STATUS_TOKEN만 바인딩하며 ADMIN_TOKEN/INGEST_TOKEN과 다르게 설정합니다.
COLLECTOR_STATUS_TOKEN=
COLLECTOR_INTAKE_TOKEN=
COLLECTOR_REVIEW_TOKEN=
COLLECTOR_EXTENSION_ORIGIN=
# 기본 비어 있음. 샌드박스·프록시 가상 대역(예: 198.18.0.0/15)을 운영자가 명시할 때만 허용.
# 루프백·링크로컬·멀티캐스트와 겹치는 대역은 지정해도 거부. 쉼표로 여러 개 가능.
COLLECTOR_TRUSTED_EGRESS_CIDRS=
COLLECTOR_DB=crawler/.cache/collector.sqlite
COLLECTOR_CONFIG=crawler/config/collector.json
COLLECTOR_SITE_URL=
# 구형 AGAMAJUNG_EXTERNAL_DRY_RUN=1은 주입 환경변수·.env.crawler 모두 이관 안내 후 Instagram 실행 없이 종료하며, 0·1·빈 값 외에는 시작 전 종료코드 1로 거부합니다.

# Daily quiet windows in Asia/Seoul; supports crossing midnight (e.g. 23:00-02:00).
# AGAMAJUNG_QUIET_WINDOW remains supported; the plural variable takes precedence.
AGAMAJUNG_QUIET_WINDOWS=06:45-08:00,13:00-14:00
