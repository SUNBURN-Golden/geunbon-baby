# 사이트(Workers) 바인딩 예시입니다. `cp .env.example .dev.vars`로 사용합니다.
# 크롤러·수집기 변수는 crawler/.env.crawler.example → 루트 .env.crawler로 별도 관리합니다.
# 사이트 서비스 토큰: 각각 24자 이상, 앞뒤 공백 없이, 세 값 모두 다르게 설정합니다.
# ADMIN_TOKEN/INGEST_TOKEN 누락·취약 값·충돌 시 admin/ingest API는 503, /admin은 설정 안내만 표시합니다.
ADMIN_TOKEN=
INGEST_TOKEN=
# 수집기 건수 동기화(POST /api/v1/collector/status) 검증용. ADMIN_TOKEN/INGEST_TOKEN과 모두 달라야 합니다.
COLLECTOR_STATUS_TOKEN=
# 소셜 로그인(구글·카카오). 비어 있는 공급자는 버튼이 숨겨지고 login/callback이 404입니다.
# 구글은 ID·SECRET 둘 다, 카카오는 REST_KEY가 있어야 켜집니다(KAKAO_CLIENT_SECRET은 선택).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
# 리디렉트 URI의 기준 주소. 비우면 https://agamajoong.soulbound.co.kr 입니다. 로컬은 아래 값을 쓰세요.
# AUTH_ORIGIN=http://localhost:8787
AUTH_ORIGIN=
NEXTJS_ENV=development
