# Required in production. In development, unset values fall back to geunbon-dev.
ADMIN_PASSWORD=change-me
# At least 16 characters. Required in production.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional. When unset, the app uses in-memory PGlite and reseeds on process start.
# Supabase example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geunbon

# Optional persistent PGlite directory, used only when DATABASE_URL is unset.
# GEUNBON_DATA_DIR=.data/pglite

# Optional. After an email is stored, POST { email, source } here. Failures are logged and do not block signup.
# NEWSLETTER_WEBHOOK_URL=https://example.com/hooks/newsletter

# Used for canonical URLs and the sitemap.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
